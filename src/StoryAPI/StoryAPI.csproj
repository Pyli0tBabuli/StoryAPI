<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>StoryAPI</AssemblyName>
    <RootNamespace>StoryAPI</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>$(NoWarn);CS1701;CS1702;MSB3277</NoWarn>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files\Epic Games\DokiDokiLitClubPlus</GameDir>
    <BepInExDir>$(GameDir)\BepInEx\core</BepInExDir>
    <ManagedDir>$(GameDir)\Doki Doki Literature Club Plus_Data\Managed</ManagedDir>
  </PropertyGroup>

