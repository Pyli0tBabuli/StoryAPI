<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline harness for the script front end.

    The lexer, AST and parser have no Unity or game dependencies, so they can be
    compiled straight into a console app. That makes it possible to check syntax in
    well under a second instead of launching the game and reading its log.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>scriptdump</AssemblyName>
    <RootNamespace>StoryAPI.Tools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\StoryAPI\Scripting\Ast.cs" />
    <Compile Include="..\..\src\StoryAPI\Scripting\Lexer.cs" />
    <Compile Include="..\..\src\StoryAPI\Scripting\Parser.cs" />
  </ItemGroup>

</Project>